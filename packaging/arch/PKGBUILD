# Local source snapshot generated by tools/build_arch_package.py.
pkgname=osu-music-player
pkgver=0.2.0
pkgrel=1
pkgdesc='Unofficial terminal music player for an existing osu!(lazer) library'
arch=('x86_64')
# No application license has been chosen; do not imply redistribution permission.
license=('custom:unlicensed')
depends=('glibc' 'gcc-libs' 'ffmpeg' 'json-c' 'sdl2' 'ncurses' 'dotnet-runtime-10.0'
         'libavformat.so' 'libavcodec.so' 'libavutil.so' 'libswresample.so')
makedepends=('gcc' 'make' 'pkgconf' 'dotnet-sdk-10.0')
checkdepends=('python' 'ffmpeg')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    make release RELEASE_CXXFLAGS="$CPPFLAGS $CXXFLAGS -DNDEBUG"
    # Framework-dependent: pacman supplies .NET, not a bundled private runtime.
    "${DOTNET:-dotnet}" restore tools/osu-indexer --locked-mode --runtime linux-x64 \
        --property:SelfContained=false --property:NuGetLockFilePath=packages.arch.lock.json
    "${DOTNET:-dotnet}" publish tools/osu-indexer --configuration Release --no-restore \
        --runtime linux-x64 --self-contained false --output artifacts/arch-indexer \
        --property:NuGetLockFilePath=packages.arch.lock.json \
        --property:PublishTrimmed=false --property:DebugType=None --property:DebugSymbols=false
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    make test
    make test-indexer
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 artifacts/release/osu-player "$pkgdir/usr/bin/osu-player"
    install -d "$pkgdir/usr/lib/osu-player/indexer"
    cp -a artifacts/arch-indexer/. "$pkgdir/usr/lib/osu-player/indexer/"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
    install -Dm644 DEVELOPMENT.md "$pkgdir/usr/share/doc/$pkgname/DEVELOPMENT.md"
    install -Dm644 packaging/arch/LICENSE-NOTICE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-NOTICE"
    install -Dm644 tools/osu-indexer/packages.lock.json "$pkgdir/usr/share/doc/$pkgname/packages.lock.json"
    install -Dm644 packaging/osu-player.desktop "$pkgdir/usr/share/applications/osu-player.desktop"
    install -Dm644 packaging/osu-player.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/osu-player.svg"
}
